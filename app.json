{
  "expo": {
    "name": "TicTacToe X",
    "slug": "tictactoe-multiplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tictactoe",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kikegonram.tictactoe"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A1E"
      },
      "package": "com.kikegonram.tictactoe"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b31879e-60b1-44aa-be71-c69ecbc21d11"
      }
    }
  }
}
