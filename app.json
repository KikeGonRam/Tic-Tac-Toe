{
  "expo": {
    "name": "TicTacToe X",
    "slug": "tictactoe-multiplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tictactoe",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kikegonram.tictactoe"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A1E"
      },
      "package": "com.kikegonram.tictactoe",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050A1E",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-av"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b31879e-60b1-44aa-be71-c69ecbc21d11"
      }
    },
    "owner": "kikegon"
  }
}
